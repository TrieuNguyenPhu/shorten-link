aws_account_id    = "REPLACE_WITH_12_DIGIT_ACCOUNT_ID"
state_bucket_name = "replace-with-globally-unique-state-bucket"
github_repository = "TrieuNguyenPhu/shorten-link"
github_environment = "dev"
# After the first approved app deployment, pin the actual output http_api_id:
# http_api_ids = ["actualapiid"]
# Operator provisions the pool once, then pins its ID before CD:
# cognito_user_pool_ids = ["ap-southeast-1_actualpoolid"]

# Operator provisions the click ESM once, then pins dev click_event_source_mapping_id:
# click_event_source_mapping_ids = ["12345678-1234-1234-1234-123456789012"]

# Operator provisions WebSocket API, then pins its ID to enable prod POST push:
# websocket_api_ids = ["actualwebsocketapiid"]
