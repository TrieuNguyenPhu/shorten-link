{
  "Comment": "Automatic URL moderation: keyword check followed by a guarded metadata status update.",
  "StartAt": "CheckSafety",
  "States": {
    "CheckSafety": {
      "Type": "Task",
      "Resource": "${ModerateCheckArn}",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkError"}],
      "Next": "IsSafe"
    },
    "IsSafe": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.safe", "BooleanEquals": true, "Next": "Activate"}],
      "Default": "Reject"
    },
    "Activate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {"PK": {"S.$": "States.Format('LINK#{}', $.code)"}, "SK": {"S": "META"}},
        "ConditionExpression": "attribute_exists(PK) AND #t = :target",
        "UpdateExpression": "SET #s = :active REMOVE #r",
        "ExpressionAttributeNames": {"#s": "status", "#r": "statusReason", "#t": "target"},
        "ExpressionAttributeValues": {":active": {"S": "active"}, ":target": {"S.$": "$.target"}}
      },
      "End": true
    },
    "Reject": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {"PK": {"S.$": "States.Format('LINK#{}', $.code)"}, "SK": {"S": "META"}},
        "ConditionExpression": "attribute_exists(PK) AND #t = :target",
        "UpdateExpression": "SET #s = :rejected, #r = :reason",
        "ExpressionAttributeNames": {"#s": "status", "#r": "statusReason", "#t": "target"},
        "ExpressionAttributeValues": {":rejected": {"S": "rejected"}, ":reason": {"S": "keyword_blocked"}, ":target": {"S.$": "$.target"}}
      },
      "End": true
    },
    "MarkError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {"PK": {"S.$": "States.Format('LINK#{}', $.code)"}, "SK": {"S": "META"}},
        "ConditionExpression": "attribute_exists(PK) AND #t = :target",
        "UpdateExpression": "SET #s = :failed, #r = :reason",
        "ExpressionAttributeNames": {"#s": "status", "#r": "statusReason", "#t": "target"},
        "ExpressionAttributeValues": {":failed": {"S": "moderation_error"}, ":reason": {"S": "workflow_failed"}, ":target": {"S.$": "$.target"}}
      },
      "End": true
    }
  }
}
