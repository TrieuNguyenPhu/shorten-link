region      = "ap-southeast-2"
environment = "dev"
web_origin  = "https://npt-shortenlink.dev"
monthly_budget_usd = 4
# budget_notification_emails = ["you@example.com"]
log_retention_days = 3

# Start with the assigned CloudFront hostname. Attach your domain only in 02B
# after checking DNS ownership and an issued ACM certificate in us-east-1.
site_domain = ""
# acm_certificate_arn = "arn:aws:acm:us-east-1:YOUR_ACCOUNT:certificate/YOUR_CERTIFICATE"
