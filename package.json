{
  "name": "npt-shortenlink",
  "version": "0.1.0",
  "private": true,
  "description": "A clean, serverless URL shortener for npt-shortenlink.dev",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "test:web": "pnpm --dir apps/web test",
    "audit:deps": "pnpm audit --prod --audit-level moderate",
    "codegraph:init": "codegraph init .",
    "codegraph:status": "codegraph status .",
    "codegraph:sync": "codegraph sync .",
    "verify": "pnpm test:web && pnpm lint:web && pnpm build:web"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
